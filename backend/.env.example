# Keitaro Admin API
KEITARO_URL=https://tlgk.host/admin_api/v1
KEITARO_API_KEY=put-your-key-here
# Кэш справочников Keitaro, сек (0 — выключить)
KEITARO_CACHE_TTL=60

# Локальная БД (SQLite)
DATABASE_URL=sqlite+aiosqlite:///./app.db

# Куда редиректит первый поток (гео-фильтр)
GEO_REDIRECT_URL=https://google.com

# Origin фронта для CORS
CORS_ORIGINS=http://localhost:5173
